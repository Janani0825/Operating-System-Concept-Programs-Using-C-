#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int is_prime(int num) {
    if (num <= 1) return 0;
    int i;
    for (i = 2; i * i <= num; i++) {
        if (num % i == 0) return 0;
    }
    return 1;
}

int main() {
    int fd[2];
    int p;
    int k= pipe(fd);
    if(k==-1)
    {
       printf("pipe creation failed");
    }
    p=fork();
    if (p== 0) {
        close(fd[0]);

        int size;
        printf("Enter the number of elements: ");
        scanf("%d", &size);
        int i;
        int arr[size];
        printf("Enter %d numbers:\n", size);
        for (i = 0; i < size; i++) {
            scanf("%d", &arr[i]);
        }

        write(fd[1], &size, sizeof(size));

        write(fd[1], arr, sizeof(arr));

        close(fd[1]);
    } else {
        close(fd[1]);

        int size;
        read(fd[0], &size, sizeof(size));

        int received_arr[size];
        read(fd[0], received_arr, sizeof(received_arr));

        printf("\n--- Results ---\n");
        int i;
        for (i = 0; i < size; i++) {
            if (is_prime(received_arr[i])) {
                printf("%d is Prime\n", received_arr[i]);
            } else {
                printf("%d is Not Prime\n", received_arr[i]);
            }
        }

        close(fd[0]);
        wait(NULL);
    }
    return 0;
}
