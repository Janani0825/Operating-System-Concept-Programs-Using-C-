#include <stdio.h>

struct Process {
    int id;
    int burst;
    int priority;
    int tat;
    int wt;
};

int main() {
    int n, i, j;
    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process p[n], temp;

    for (i = 0; i < n; i++) {
        p[i].id = i + 1;
        printf("P%d Burst Time: ", p[i].id);
        scanf("%d", &p[i].burst);
        printf("P%d Priority: ", p[i].id);
        scanf("%d", &p[i].priority);
    }

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (p[j].priority > p[j + 1].priority) {
                temp = p[j];
                p[j] = p[j + 1];
                p[j + 1] = temp;
            }
        }
    }

    int current_time = 0;

    printf("\nPID\tPriority\tBurst\tTurnAround\tWaiting\n");

    for (i = 0; i < n; i++) {
        current_time += p[i].burst;

        p[i].tat = current_time;
        p[i].wt = p[i].tat - p[i].burst;

        printf("P%d\t%d\t\t%d\t%d\t\t%d\n", p[i].id, p[i].priority, p[i].burst, p[i].tat, p[i].wt);
    }

    float total_tat = 0, total_wt = 0;
    for (i = 0; i < n; i++) {
        total_tat += p[i].tat;
        total_wt += p[i].wt;
    }

    printf("\nAverage Turnaround Time: %.2f\n", total_tat / n);
    printf("Average Waiting Time: %.2f\n", total_wt / n);

    return 0;
}
