#include <stdio.h>

struct Process {
    int id;
    int burst;
    int remaining_burst;
    int tat;
    int wt;
};

int main() {
    int n, i, quantum;
    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process p[n];

    for (i = 0; i < n; i++) {
        p[i].id = i + 1;
        printf("P%d Burst Time: ", p[i].id);
        scanf("%d", &p[i].burst);
        p[i].remaining_burst = p[i].burst;
    }

    printf("Enter Time Quantum: ");
    scanf("%d", &quantum);

    int current_time = 0;
    int completed = 0;

    while (completed < n) {
        for (i = 0; i < n; i++) {
            if (p[i].remaining_burst > 0) {
                if (p[i].remaining_burst > quantum) {
                    current_time += quantum;
                    p[i].remaining_burst -= quantum;
                } else {
                    current_time += p[i].remaining_burst;
                    p[i].tat = current_time; // Reached completion time
                    p[i].wt = p[i].tat - p[i].burst;
                    p[i].remaining_burst = 0;
                    completed++;
                }
            }
        }
    }

    printf("\nPID\tBurst\tTurnAround\tWaiting\n");
    float total_tat = 0, total_wt = 0;

    for (i = 0; i < n; i++) {
        total_tat += p[i].tat;
        total_wt += p[i].wt;
        printf("P%d\t%d\t%d\t\t%d\n", p[i].id, p[i].burst, p[i].tat, p[i].wt);
    }

    printf("\nAverage Turnaround Time: %.2f\n", total_tat / n);
    printf("Average Waiting Time: %.2f\n", total_wt / n);

    return 0;
}
