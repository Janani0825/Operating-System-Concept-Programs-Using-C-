#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
   int n, i;
   char x;

   printf("Enter no of characters: ");
   scanf("%d", &n);

   char str[n];
   printf("Enter characters: ");
   for(i = 0; i < n; i++){
      scanf(" %c", &str[i]);
   }

   printf("Enter element: ");
   scanf(" %c", &x);


   int p2_id = fork();

   if (p2_id > 0) {
      printf("\nP1 (Original array): ");
      for(i = 0; i < n; i++){
         printf("%c ", str[i]);
      }
      printf("\n");

      wait(NULL);
   }
   else if (p2_id == 0) {

      int p3_id = fork();
      if (p3_id > 0) {
         printf("P2 (Reverse array): ");
         for(i = n - 1; i >= 0; i--){
            printf("%c ", str[i]);
         }
         printf("\n");

         wait(NULL);
      }
      else if (p3_id == 0) {
         int count = 0;
         for(i = 0; i < n; i++){
            if(str[i] == x){
               count += 1;
            }
         }
         printf("P3 (Frequency of '%c'): %d\n", x, count);
      }
   }

   return 0;
}
