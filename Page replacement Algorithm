#include <stdio.h>
int main()
{
    int pages[50], frame[10];
    int n, f, i, j, k;
    int pageFaults, found;
    printf("Enter number of pages: ");
    scanf("%d", &n);
    printf("Enter page reference string:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &pages[i]);
    printf("Enter number of frames: ");
    scanf("%d", &f);
    pageFaults = 0;
    k = 0;
    for (i = 0; i < f; i++)
        frame[i] = -1;

    printf("\n--- FIFO Page Replacement ---\n");
    for (i = 0; i < n; i++)
    {
        found = 0;

        for (j = 0; j < f; j++)
        {
            if (frame[j] == pages[i])
            {
                found = 1;
                break;
            }
        }

        if (found == 0)
        {
            frame[k] = pages[i];
            k = (k + 1) % f;
            pageFaults++;
        }

        printf("Page %d : ", pages[i]);
        for (j = 0; j < f; j++)
            printf("%d ", frame[j]);

        if (found == 0)
            printf("  Fault");

        printf("\n");
    }

    printf("Total Page Faults = %d\n", pageFaults);
    pageFaults = 0;
    for (i = 0; i < f; i++)
        frame[i] = -1;
    printf("\n--- LRU Page Replacement ---\n");
    int recent[10];
    for (i = 0; i < f; i++)
        recent[i] = -1;
    for (i = 0; i < n; i++)
    {
        found = 0;
        for (j = 0; j < f; j++)
        {
            if (frame[j] == pages[i])
            {
                found = 1;
                recent[j] = i;
                break;
            }
        }
        if (found == 0)
        {
            int pos = 0;
            pageFaults++;
            for (j = 0; j < f; j++)
            {
                if (frame[j] == -1)
                {
                    pos = j;
                    break;
                }
            }
            if (frame[pos] != -1)
            {
                for (j = 1; j < f; j++)
                {
                    if (recent[j] < recent[pos])
                        pos = j;
                }
            }

            frame[pos] = pages[i];
            recent[pos] = i;
        }

        printf("Page %d : ", pages[i]);

        for (j = 0; j < f; j++)
            printf("%d ", frame[j]);

        if (found == 0)
            printf("  Fault");

        printf("\n");
    }

    printf("Total Page Faults = %d\n", pageFaults);
    pageFaults = 0;

    for (i = 0; i < f; i++)
        frame[i] = -1;

    printf("\n--- Optimal Page Replacement ---\n");

    for (i = 0; i < n; i++)
    {
        found = 0;
        for (j = 0; j < f; j++)
        {
            if (frame[j] == pages[i])
            {
                found = 1;
                break;
            }
        }

        if (found == 0)
        {
            int pos = -1;
            int farthest = -1;

            pageFaults++;
            for (j = 0; j < f; j++)
            {
                if (frame[j] == -1)
                {
                    pos = j;
                    break;
                }
            }
            if (pos == -1)
            {
                for (j = 0; j < f; j++)
                {
                    int next = -1;

                    for (k = i + 1; k < n; k++)
                    {
                        if (frame[j] == pages[k])
                        {
                            next = k;
                            break;
                        }
                    }
                    if (next == -1)
                    {
                        pos = j;
                        break;
                    }

                    if (next > farthest)
                    {
                        farthest = next;
                        pos = j;
                    }
                }
            }

            frame[pos] = pages[i];
        }

        printf("Page %d : ", pages[i]);

        for (j = 0; j < f; j++)
            printf("%d ", frame[j]);

        if (found == 0)
            printf("  Fault");

        printf("\n");
    }

    printf("Total Page Faults = %d\n", pageFaults);

    return 0;
}
