#include <stdio.h>
#define MAX_P 10
#define MAX_R 10
int main()
{
    int n, m;
    int allocation[MAX_P][MAX_R];
    int max[MAX_P][MAX_R];
    int need[MAX_P][MAX_R];
    int available[MAX_R];
    int work[MAX_R];
    int finish[MAX_P];
    int safeSequence[MAX_P];
    int request[MAX_R];
    int p;
    int i, j;
    int count, found, possible;
    printf("Enter number of processes: ");
    scanf("%d", &n);
    printf("Enter number of resource types: ");
    scanf("%d", &m);
    printf("\nEnter Allocation Matrix:\n");
    for (i = 0; i < n; i++)
    {
        printf("P%d: ", i);

        for (j = 0; j < m; j++)
        {
            scanf("%d", &allocation[i][j]);
        }
    }
    printf("\nEnter Max Matrix:\n");
    for (i = 0; i < n; i++)
    {
        printf("P%d: ", i);

        for (j = 0; j < m; j++)
        {
            scanf("%d", &max[i][j]);
        }
    }
    printf("\nEnter Available Resources:\n");

    for (j = 0; j < m; j++)
    {
        scanf("%d", &available[j]);
    }
    for (i = 0; i < n; i++)
    {
        for (j = 0; j < m; j++)
        {
            need[i][j] = max[i][j] - allocation[i][j];
        }
    }
    printf("\nNeed Matrix:\n");

    for (i = 0; i < n; i++)
    {
        printf("P%d: ", i);

        for (j = 0; j < m; j++)
        {
            printf("%d ", need[i][j]);
        }

        printf("\n");
    }
    for (j = 0; j < m; j++)
    {
        work[j] = available[j];
    }
    for (i = 0; i < n; i++)
    {
        finish[i] = 0;
    }

    count = 0;

    while (count < n)
    {
        found = 0;

        for (i = 0; i < n; i++)
        {
            if (finish[i] == 0)
            {
                possible = 1;
                for (j = 0; j < m; j++)
                {
                    if (need[i][j] > work[j])
                    {
                        possible = 0;
                        break;
                    }
                }

                if (possible)
                {
                    for (j = 0; j < m; j++)
                    {
                        work[j] = work[j] + allocation[i][j];
                    }
                    finish[i] = 1;
                    safeSequence[count] = i;

                    count++;

                    found = 1;
                }
            }
        }
        if (found == 0)
        {
            break;
        }
    }
    if (count != n)
    {
        printf("\nSYSTEM UNSAFE STATE.\n");
        return 0;
    }
    printf("\nSYSTEM SAFE STATE.\n");
    printf("SAFE SEQUENCE: ");
    for (i = 0; i < n; i++)
    {
        printf("P%d", safeSequence[i]);

        if (i != n - 1)
        {
            printf(" -> ");
        }
    }

    printf("\n");
    printf("\n----------------------------------------\n");
    printf("RESOURCE-REQUEST ALGORITHM\n");
    printf("----------------------------------------\n");
    printf("\nEnter process number to the request: ");
    scanf("%d", &p);
    if (p < 0 || p >= n)
    {
        printf("Invalid process number.\n");
        return 0;
    }

    printf("Enter Request for P%d:\n", p);

    for (j = 0; j < m; j++)
    {
        scanf("%d", &request[j]);
    }
    printf("\nStep 1: Checking Request <= Need\n");
    for (j = 0; j < m; j++)
    {
        if (request[j] > need[p][j])
        {
            printf("Request exceeds the maximum claim.\n");
            printf("Request CANNOT be granted.\n");
            return 0;
        }
    }
    printf("Request <= Need : YES\n");
    printf("\nStep 2: Checking Request <= Available\n");
    for (j = 0; j < m; j++)
    {
        if (request[j] > available[j])
        {
            printf("Request <= Available : NO\n");
            printf("Resources are not available.\n");
            printf("Process P%d must WAIT.\n", p);
            return 0;
        }
    }

    printf("Request <= Available : YES\n");
    printf("\nStep 3: Pretending to allocate resources\n");

    for (j = 0; j < m; j++)
    {
        available[j] = available[j] - request[j];

        allocation[p][j] = allocation[p][j] + request[j];

        need[p][j] = need[p][j] - request[j];
    }
    for (j = 0; j < m; j++)
    {
        work[j] = available[j];
    }

    for (i = 0; i < n; i++)
    {
        finish[i] = 0;
    }

    count = 0;

    while (count < n)
    {
        found = 0;

        for (i = 0; i < n; i++)
        {
            if (finish[i] == 0)
            {
                possible = 1;

                for (j = 0; j < m; j++)
                {
                    if (need[i][j] > work[j])
                    {
                        possible = 0;
                        break;
                    }
                }

                if (possible)
                {
                    for (j = 0; j < m; j++)
                    {
                        work[j] = work[j] + allocation[i][j];
                    }

                    finish[i] = 1;

                    safeSequence[count] = i;

                    count++;

                    found = 1;
                }
            }
        }

        if (found == 0)
        {
            break;
        }
    }
    if (count == n)
    {
        printf("\n----------------------------------------\n");
        printf("REQUEST CAN BE GRANTED.\n");
        printf("----------------------------------------\n");

        printf("System remains in SAFE STATE.\n");

        printf("New Safe Sequence: ");

        for (i = 0; i < n; i++)
        {
            printf("P%d", safeSequence[i]);

            if (i != n - 1)
            {
                printf(" -> ");
            }
        }

        printf("\n");
    }
    else
    {
        printf("\n----------------------------------------\n");
        printf("REQUEST CANNOT BE GRANTED.\n");
        printf("----------------------------------------\n");
        printf("System would become UNSAFE.\n");
        for (j = 0; j < m; j++)
        {
            available[j] = available[j] + request[j];

            allocation[p][j] = allocation[p][j] - request[j];

            need[p][j] = need[p][j] + request[j];
        }

        printf("Old resource allocation state restored.\n");
    }

    return 0;
}
