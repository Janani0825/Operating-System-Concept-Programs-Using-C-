#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>
int isPrime(int n) {
    if (n <= 1) return 0;
    int i;
    for (i = 2; i * i <= n; i++) {
        if (n % i == 0) return 0;
    }
    return 1;
}

int main() {
    int n,i;

    printf("Enter number of integers (n): ");
    scanf("%d", &n);

    int shmid = shmget(IPC_PRIVATE, n * sizeof(int), IPC_CREAT | 0666);
    if (shmid < 0) {
        perror("shmget failed");
        exit(1);
    }

    pid_t pid = fork();

    if (pid < 0) {
        perror("fork failed");
        exit(1);
    }

    if (pid == 0) {
        int *arr = (int *)shmat(shmid, NULL, 0);

        printf("\n[Child] Enter %d integers:\n", n);
        for (i = 0; i < n; i++) {
            scanf("%d", &arr[i]);
        }

        int child_count = 0;
        printf("\n[Child] Prime numbers in the first half: ");
        for (i = 0; i < n / 2; i++) {
            if (isPrime(arr[i])) {
                printf("%d ", arr[i]);
                child_count++;
            }
        }
        printf("\n[Child] Count of primes in first half: %d\n", child_count);

        shmdt(arr);
        exit(0);

    } else {
        wait(NULL);

        int *arr = (int *)shmat(shmid, NULL, 0);

        int parent_count = 0;
        printf("\n[Parent] Prime numbers in the second half: ");
        for (i = n / 2; i < n; i++) {
            if (isPrime(arr[i])) {
                printf("%d ", arr[i]);
                parent_count++;
            }
        }
        printf("\n[Parent] Count of primes in second half: %d\n", parent_count);

        shmdt(arr);
        shmctl(shmid, IPC_RMID, NULL);
    }

    return 0;
}
