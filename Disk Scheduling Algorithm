#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

#define MAX 200

/* ---------- helpers ---------- */
int abs_diff(int a, int b) { return (a > b) ? (a - b) : (b - a); }

int cmp(const void *a, const void *b) {
    long x = *(const int *)a, y = *(const int *)b;
    return (x > y) - (x < y);           /* overflow-safe */
}

void copy_arr(int src[], int dst[], int n) {
    int i;
    for (i = 0; i < n; i++) dst[i] = src[i];
}

/* ---------- single display method ---------- */
void display(const char *name, int path[], int len) {
    int i, seek, total = 0;
    printf("%-6s: %d", name, path[0]);
    for (i = 1; i < len; i++) {
        seek = abs_diff(path[i - 1], path[i]);
        total += seek;
        printf(" -> %d (+%d, cum=%d)", path[i], seek, total);
    }
    printf("\n%-6s total head movement = %d\n\n", name, total);
}

/* ---------- algorithms: each fills path[], returns its length ---------- */

int fcfs(int req[], int n, int head, int path[]) {
    int len = 0, i;
    path[len++] = head;
    for (i = 0; i < n; i++) path[len++] = req[i];
    return len;
}

int sstf(int req[], int n, int head, int path[]) {
    int visited[MAX] = {0};
    int cur = head, len = 0, i, j, best, bestdist, d;
    path[len++] = head;
    for (i = 0; i < n; i++) {
        best = -1;
        bestdist = INT_MAX;
        for (j = 0; j < n; j++) {
            if (!visited[j]) {
                d = abs_diff(cur, req[j]);
                if (d < bestdist) { bestdist = d; best = j; }
            }
        }
        visited[best] = 1;
        cur = req[best];
        path[len++] = cur;
    }
    return len;
}

int scan(int req[], int n, int head, int disk_size, int dir, int path[]) {
    int s[MAX];
    int len = 0, cur = head, i;
    copy_arr(req, s, n);
    qsort(s, n, sizeof(int), cmp);

    path[len++] = head;

    if (dir == 1) {
        for (i = 0; i < n; i++)
            if (s[i] >= head) { cur = s[i]; path[len++] = cur; }
        path[len++] = disk_size - 1;
        for (i = n - 1; i >= 0; i--)
            if (s[i] < head) { cur = s[i]; path[len++] = cur; }
        path[len++] = 0;
    } else {
        for (i = n - 1; i >= 0; i--)
            if (s[i] <= head) { cur = s[i]; path[len++] = cur; }
        path[len++] = 0;
        for (i = 0; i < n; i++)
            if (s[i] > head) { cur = s[i]; path[len++] = cur; }
        path[len++] = disk_size - 1;
    }
    return len;
}

int cscan(int req[], int n, int head, int disk_size, int dir, int path[]) {
    int s[MAX];
    int len = 0, cur = head, i;
    copy_arr(req, s, n);
    qsort(s, n, sizeof(int), cmp);

    path[len++] = head;

    if (dir == 1) {
        for (i = 0; i < n; i++)
            if (s[i] >= head) { cur = s[i]; path[len++] = cur; }
        path[len++] = disk_size - 1;
        path[len++] = 0;
        for (i = 0; i < n; i++)
            if (s[i] < head) { cur = s[i]; path[len++] = cur; }
    } else {
        for (i = n - 1; i >= 0; i--)
            if (s[i] <= head) { cur = s[i]; path[len++] = cur; }
        path[len++] = 0;
        path[len++] = disk_size - 1;
        for (i = n - 1; i >= 0; i--)
            if (s[i] > head) { cur = s[i]; path[len++] = cur; }
    }
    return len;
}

int look(int req[], int n, int head, int dir, int path[]) {
    int s[MAX];
    int len = 0, cur = head, i;
    copy_arr(req, s, n);
    qsort(s, n, sizeof(int), cmp);

    path[len++] = head;

    if (dir == 1) {
        for (i = 0; i < n; i++)
            if (s[i] >= head) { cur = s[i]; path[len++] = cur; }
        for (i = n - 1; i >= 0; i--)
            if (s[i] < head) { cur = s[i]; path[len++] = cur; }
    } else {
        for (i = n - 1; i >= 0; i--)
            if (s[i] <= head) { cur = s[i]; path[len++] = cur; }
        for (i = 0; i < n; i++)
            if (s[i] > head) { cur = s[i]; path[len++] = cur; }
    }
    return len;
}

int clook(int req[], int n, int head, int dir, int path[]) {
    int s[MAX];
    int len = 0, cur = head, i;
    copy_arr(req, s, n);
    qsort(s, n, sizeof(int), cmp);

    path[len++] = head;

    if (dir == 1) {
        for (i = 0; i < n; i++)
            if (s[i] >= head) { cur = s[i]; path[len++] = cur; }
        if (n > 0) { cur = s[0]; path[len++] = cur; }
        for (i = 0; i < n; i++)
            if (s[i] < head) { cur = s[i]; path[len++] = cur; }
    } else {
        for (i = n - 1; i >= 0; i--)
            if (s[i] <= head) { cur = s[i]; path[len++] = cur; }
        if (n > 0) { cur = s[n - 1]; path[len++] = cur; }
        for (i = n - 1; i >= 0; i--)
            if (s[i] > head) { cur = s[i]; path[len++] = cur; }
    }
    return len;
}

/* ---------- main ---------- */
int main(void) {
    int n, head, disk_size, dir, i;
    int req[MAX], path[MAX];

    printf("Enter number of requests: ");
    if (scanf("%d", &n) != 1 || n <= 0 || n > 100) { printf("Invalid count\n"); return 1; }

    printf("Enter request queue (%d values): ", n);
    for (i = 0; i < n; i++) scanf("%d", &req[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size (total cylinders): ");
    scanf("%d", &disk_size);

    printf("Direction (1 = high cylinders, 0 = low cylinders): ");
    scanf("%d", &dir);

    printf("\n");

    display("FCFS",  path, fcfs (req, n, head, path));
    display("SSTF",  path, sstf (req, n, head, path));
    display("SCAN",  path, scan (req, n, head, disk_size, dir, path));
    display("CSCAN", path, cscan(req, n, head, disk_size, dir, path));
    display("LOOK",  path, look (req, n, head, dir, path));
    display("CLOOK", path, clook(req, n, head, dir, path));

    return 0;
}
