#include<stdio.h>
#include<unistd.h>
#include<sys/types.h>
#include<sys/wait.h>
int main()
{
   int n,sum=0,countofeven=0;
   printf("Enter the no of elements:");
   scanf("%d",&n);
   int arr[n];
   printf("Enter the elements:");
   int i;
   for(i=0;i<n;i++)
   {
      scanf("%d",&arr[i]);
   }
   int id;
   id=fork();
   if(id>0)
   {
      printf("\n[Parent] Process ID (PID): %d\n", getpid());
      printf("[Parent] Created Child Process with PID: %d\n", id);

      int i;
      for( i =0;i<n;i++){
         sum+=arr[i];
      }
      printf("sum of elements:%d\n",sum);
      wait(NULL);
   }
   else if(id == 0)
   {
      printf("\n[Child] Process ID (PID): %d\n", getpid());
      printf("[Child] Parent Process ID (PPID): %d\n", getppid());

      int i;
      for(i=0;i<n;i++){
         if(arr[i]%2==0){
            countofeven++;
         }
      }
      printf("count of even number:%d\n",countofeven);
   }
   else
   {
      printf("Fork failed!\n");
      return 1;
   }

   return 0;
}

