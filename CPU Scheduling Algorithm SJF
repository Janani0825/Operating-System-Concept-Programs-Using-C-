#include <stdio.h>

struct Process {
    int id;
    int arrival;
    int burst;
    int tat;
    int wt;
};

int main() {
    int n, i, j;
    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process p[n], temp;

    for (i = 0; i < n; i++) {
        p[i].id = i + 1;
        printf("P%d Arrival: ", p[i].id);
        scanf("%d", &p[i].arrival);
        printf("P%d Burst: ", p[i].id);
        scanf("%d", &p[i].burst);
    }

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (p[j].arrival > p[j + 1].arrival ||
               (p[j].arrival == p[j + 1].arrival && p[j].burst > p[j + 1].burst)) {
                temp = p[j];
                p[j] = p[j + 1];
                p[j + 1] = temp;
            }
        }
    }

    int current_time = 0;

    for (i = 0; i < n; i++) {
        if (current_time < p[i].arrival) {
            current_time = p[i].arrival;
        }

        for (j = i + 1; j < n; j++) {
            if (p[j].arrival <= current_time) {
                if (p[j].burst < p[i].burst) {
                    temp = p[i];
                    p[i] = p[j];
                    p[j] = temp;
                }
            }
        }

        current_time += p[i].burst;
        p[i].tat = current_time - p[i].arrival;
        p[i].wt = p[i].tat - p[i].burst;
    }

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (p[j].id > p[j + 1].id) {
                temp = p[j];
                p[j] = p[j + 1];
                p[j + 1] = temp;
            }
        }
    }

    printf("\nPID\tArrival\tBurst\tTurnAround\tWaiting\n");
    float total_tat = 0, total_wt = 0;

    for (i = 0; i < n; i++) {
        total_tat += p[i].tat;
        total_wt += p[i].wt;
        printf("P%d\t%d\t%d\t%d\t\t%d\n", p[i].id, p[i].arrival, p[i].burst, p[i].tat, p[i].wt);
    }

    printf("\nAverage Turnaround Time: %.2f\n", total_tat / n);
    printf("Average Waiting Time: %.2f\n", total_wt / n);

    return 0;
}
